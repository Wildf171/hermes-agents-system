# ============================================================================
# NEO CURRÍCULOS + NEO RH - CONFIGURAÇÃO DE AMBIENTE
# ============================================================================

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_APP=app.py

# ============================================================================
# BANCO DE DADOS - MONGODB
# ============================================================================
MONGO_URI=mongodb://admin:password@localhost:27017/neo_rh
MONGO_USER=admin
MONGO_PASSWORD=password
MONGO_DB=neo_rh

# ============================================================================
# JWT - AUTENTICAÇÃO
# ============================================================================
JWT_SECRET_KEY=seu-secret-key-aqui-min-32-caracteres-aleatorios-aqui
JWT_ACCESS_TOKEN_EXPIRES=86400  # 24 horas em segundos
JWT_REFRESH_TOKEN_EXPIRES=2592000  # 30 dias em segundos

# ============================================================================
# ARMAZENAMENTO - S3/MINIO
# ============================================================================
STORAGE_TYPE=minio  # "s3" ou "minio"
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=neo-curriculos
MINIO_USE_SSL=false

# AWS S3 (alternativa ao MinIO)
# AWS_ACCESS_KEY_ID=seu-access-key
# AWS_SECRET_ACCESS_KEY=seu-secret-key
# AWS_S3_BUCKET=seu-bucket
# AWS_S3_REGION=us-east-1

# ============================================================================
# CORS E SEGURANÇA
# ============================================================================
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://localhost:5000"]
ALLOWED_UPLOAD_EXTENSIONS=["pdf"]
MAX_UPLOAD_SIZE_MB=10

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_LOGIN=5/15minute
RATE_LIMIT_REGISTER=10/1hour
RATE_LIMIT_UPLOAD=20/1hour

# ============================================================================
# LGPD E RETENÇÃO DE DADOS
# ============================================================================
DATA_RETENTION_DAYS=30  # Dias antes de anonimizar conta deletada
AUDIT_LOG_TTL_YEARS=7  # Retenção de auditoria LGPD

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json  # "json" ou "text"

# ============================================================================
# ANTIVÍRUS (Mock em desenvolvimento)
# ============================================================================
ANTIVIRUS_ENABLED=false
# CLAMAVC_HOST=localhost
# CLAMAVC_PORT=3310

# ============================================================================
# EMAIL (Opcional - para notificações)
# ============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app
SMTP_FROM=noreply@neocurriculos.com.br

# ============================================================================
# AMBIENTE
# ============================================================================
ENVIRONMENT=development  # development, staging, production
DEBUG_MODE=true
API_VERSION=v1
