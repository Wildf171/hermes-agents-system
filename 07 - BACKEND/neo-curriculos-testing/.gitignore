# ============================================================================
# SPECIFIC IGNORES FOR THIS PROJECT
# ============================================================================

# Test coverage reports (keep only in CI/CD)
htmlcov/
coverage.xml

# Load test reports (keep archive)
LOAD_TEST_REPORT*.md

# Prometheus/Grafana data
prometheus-data/
grafana/

# Docker volumes
volumes/
data/

# Backup files
*.backup
*.bak
backups/

# SSH keys
*.pem
!example.pem

# ============================================================================
# BUT KEEP THESE
# ============================================================================

# Keep important documentation
!docs/
!scripts/
!monitoring/
!.github/

# Keep requirements
!requirements*.txt

# Keep configuration templates
!.env.example
!.env.staging.example

# Keep test files
!tests/
!conftest.py
!pytest.ini

# ============================================================================
